# ─────────────────────────────────────────────────────────────────────────────
# Client (browser) env — NO provider API keys here anymore.
# All LLM/embedding calls route through the `ai-proxy` Supabase Edge Function,
# which holds the real keys server-side. See supabase/functions/ai-proxy.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (authentication + database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google OAuth — read by the Supabase Auth *server* (supabase/config.toml), not
# the browser app, so no VITE_ prefix. Create credentials in Google Cloud Console
# (OAuth client ID, type "Web application"), authorized redirect URI
# <your-supabase-project-url>/auth/v1/callback. For local dev with the Supabase
# CLI, set these in supabase/functions/.env or your shell before `supabase start`;
# for hosted prod, set them in Supabase Dashboard → Authentication → Providers → Google
# (the dashboard's own client id/secret fields — this repo's config.toml only
# governs local dev).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret

# AI proxy base URL — defaults to <VITE_SUPABASE_URL>/functions/v1/ai-proxy.
# Override only for local dev against a separately-served function.
# VITE_AI_PROXY_URL=http://127.0.0.1:54321/functions/v1/ai-proxy

# AI provider toggle (secret-free feature flag — NOT a key). Claude is the sole
# LLM provider; the real Anthropic key lives server-side (see supabase/functions).
VITE_CLAUDE_ENABLED=true

# Web Push public VAPID key (safe to expose — enables reminders when the app is closed).
# Generate a pair: npx web-push generate-vapid-keys
# Public key goes here; private key becomes an edge secret (see supabase/functions).
VITE_VAPID_PUBLIC_KEY=

# PostHog analytics (optional — leave blank to disable in development)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry error monitoring (optional)
# VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Build-time only (NOT shipped to the browser) — used by scripts/ (RAG ingest etc.)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase Service Role Key (knowledge ingestion scripts ONLY — never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Jina key for the RAG ingestion scripts (npm run rag:ingest / rag:verify).
# Build-time only — the browser app never reads this; runtime embeddings go
# through the ai-proxy edge function instead.
VITE_JINA_API_KEY=jina_your_key_here

# Groq key for the offline knowledge-ingestion scripts ONLY (scripts/ingest-knowledge.ts
# contextual enrichment, scripts/build-raptor-index.ts summary generation) — cheap
# bulk summarization via llama-3.1-8b-instant. Not used by the running app; every
# live LLM call goes through Claude via the ai-proxy edge function.
VITE_GROQ_API_KEY=gsk_your_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Edge-function secrets live in supabase/functions/.env (gitignored) for local dev,
# or `supabase secrets set` in prod. See supabase/functions/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

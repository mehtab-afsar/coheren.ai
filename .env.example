# ─────────────────────────────────────────────────────────────────────────────
# Client (browser) env — NO provider API keys here anymore.
# All LLM/embedding calls route through the `ai-proxy` Supabase Edge Function,
# which holds the real keys server-side. See supabase/functions/ai-proxy.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (authentication + database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# AI proxy base URL — defaults to <VITE_SUPABASE_URL>/functions/v1/ai-proxy.
# Override only for local dev against a separately-served function.
# VITE_AI_PROXY_URL=http://127.0.0.1:54321/functions/v1/ai-proxy

# AI provider toggles (secret-free feature flags — NOT keys)
VITE_GROQ_ENABLED=true
VITE_CLAUDE_ENABLED=false

# Web Push public VAPID key (safe to expose — enables reminders when the app is closed).
# Generate a pair: npx web-push generate-vapid-keys
# Public key goes here; private key becomes an edge secret (see supabase/functions).
VITE_VAPID_PUBLIC_KEY=

# PostHog analytics (optional — leave blank to disable in development)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry error monitoring (optional)
# VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Build-time only (NOT shipped to the browser) — used by scripts/ (RAG ingest etc.)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase Service Role Key (knowledge ingestion scripts ONLY — never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Jina key for the RAG ingestion scripts (npm run rag:ingest / rag:verify).
# Build-time only — the browser app never reads this; runtime embeddings go
# through the ai-proxy edge function instead.
VITE_JINA_API_KEY=jina_your_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Edge-function secrets live in supabase/functions/.env (gitignored) for local dev,
# or `supabase secrets set` in prod. See supabase/functions/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

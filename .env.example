# Groq API (for AI agents — text generation)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Supabase (for authentication and database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Jina AI (for RAG semantic search — free at https://jina.ai, 1M tokens/month)
VITE_JINA_API_KEY=jina_your_key_here

# Supabase Service Role Key (for knowledge ingestion script ONLY — never expose in browser)
# Find in: Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PostHog analytics (optional — leave blank to disable in development)
# Get your key at: https://app.posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

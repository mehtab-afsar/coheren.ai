# ============================================================================
# PRODUCTION Environment — Coheren
# ============================================================================
# Copy this file, fill in real values, and add them to your deployment
# platform (Vercel / Netlify / Railway env vars panel).
# NEVER commit this file with real secrets.
# ============================================================================

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Find in: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-prod-anon-key

# ── AI providers (at least one required) ─────────────────────────────────────
# OpenRouter (recommended — routes to Claude Sonnet / Gemini Flash)
# https://openrouter.ai → Keys → Create key
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Groq (economy tier — Shadow Extractor + Task Generator)
# https://console.groq.com → API Keys → Create
VITE_GROQ_API_KEY=gsk_your-groq-key

# ── RAG / embeddings (optional) ──────────────────────────────────────────────
# Jina AI v3 embeddings — free tier: 1M tokens/month
# https://jina.ai → Dashboard → API Keys
VITE_JINA_API_KEY=jina_your-key

# ── Analytics (optional) ──────────────────────────────────────────────────────
# PostHog — leave blank to disable analytics
# https://app.posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_your-posthog-key
VITE_POSTHOG_HOST=https://app.posthog.com

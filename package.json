{
  "name": "coheren-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:reset": "supabase db reset",
    "db:seed-dump": "node --env-file=.env.local node_modules/.bin/tsx scripts/dump-seed.ts",
    "db:verify": "chmod +x scripts/verify-db-data.sh && ./scripts/verify-db-data.sh",
    "db:tables": "docker exec supabase_db_consist psql -U postgres -d postgres -c \"SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' ORDER BY table_name;\"",
    "db:feedback": "docker exec supabase_db_consist psql -U postgres -d postgres -c \"SELECT difficulty_score, actual_duration_mins, feedback_tags, created_at FROM task_feedback ORDER BY created_at DESC LIMIT 10;\"",
    "db:status": "docker exec supabase_db_consist psql -U postgres -d postgres -c \"SELECT schemaname, tablename, pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename)) AS size FROM pg_tables WHERE schemaname = 'public' ORDER BY pg_total_relation_size(schemaname||'.'||tablename) DESC;\"",
    "db:connect": "docker exec -it supabase_db_consist psql -U postgres -d postgres",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:restart": "supabase restart",
    "supabase:logs": "supabase logs",
    "type-check": "tsc --noEmit",
    "ci": "npm run lint && npm run type-check && npm run test && npm run test:e2e:smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/smoke.test.ts",
    "rag:ingest": "node --env-file=.env node_modules/.bin/tsx scripts/ingest-knowledge.ts",
    "rag:raptor": "node --env-file=.env node_modules/.bin/tsx scripts/build-raptor-index.ts",
    "rag:verify": "node --env-file=.env node_modules/.bin/tsx scripts/verify-rag.ts",
    "resources:ingest": "node --env-file=.env node_modules/.bin/tsx scripts/ingest-resources.ts",
    "test:pipeline": "node --env-file=.env node_modules/.bin/tsx scripts/test-full-pipeline.ts",
    "resources:validate": "node_modules/.bin/tsx scripts/validate-resources.ts",
    "test:matrix": "node --env-file=.env node_modules/.bin/tsx scripts/test-matrix.ts",
    "test:matrix:quick": "node --env-file=.env node_modules/.bin/tsx scripts/test-matrix.ts --quick",
    "test:simulation": "node --env-file=.env node_modules/.bin/tsx --tsconfig tsconfig.scripts.json scripts/test-10day-simulation.ts",
    "test:simulation:dry": "node --env-file=.env node_modules/.bin/tsx --tsconfig tsconfig.scripts.json scripts/test-10day-simulation.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@number-flow/react": "^0.5.11",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.46.0",
    "@supabase/supabase-js": "^2.94.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.33.0",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.562.0",
    "posthog-js": "^1.353.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.0"
  }
}

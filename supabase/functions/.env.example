# Secrets for the ai-proxy edge function.
# Local dev: copy to supabase/functions/.env (gitignored) with real values, then
#   supabase functions serve --env-file supabase/functions/.env
# Production: set via `supabase secrets set ANTHROPIC_API_KEY=... JINA_API_KEY=...`
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by the Supabase runtime — no need to set them here.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
JINA_API_KEY=jina_your_key_here

# Requests per minute per user before the gateway returns 429 (default 60).
AI_PROXY_RATE_LIMIT=60

# ── Web Push (send-reminders function) ──────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The PUBLIC key must match the client's VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:hello@coheren.ai

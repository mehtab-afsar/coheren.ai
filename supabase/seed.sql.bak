  3,
  'Writing Your First Functions',
  '{
    "description": "Functions are reusable blocks of code. Today you learn to write functions that take inputs and return outputs.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Write a function: function greet(name) { return ''Hello, '' + name + ''!''; }",
      "Call it: console.log(greet(''Alex''))",
      "Write a math function: function add(a, b) { return a + b; }",
      "Call it: console.log(add(5, 3))",
      "Try arrow function syntax: const multiply = (a, b) => a * b;",
      "Call: console.log(multiply(4, 6))",
      "Write a function for YOUR project: function findGig(musician, city) { return musician + '' is looking for gigs in '' + city; }"
    ],
    "tips": [
      "A function without a return statement returns undefined",
      "Arrow functions (=>) are modern shorthand — you will see them everywhere",
      "Functions should do ONE thing — keep them small and focused"

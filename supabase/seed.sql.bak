-- Day 4: If/Else and Conditionals
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555504',
  '44444444-4444-4444-4444-444444444444',
  4,
  'Making Decisions with If/Else',
  '{
    "description": "Programs make decisions based on conditions. Learn if/else to make your code respond differently to different inputs.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Write: if (5 > 3) { console.log(''Math works!''); }",
      "Add an else: if (5 < 3) { console.log(''No''); } else { console.log(''Yes!''); }",
      "Create a function: function checkAge(age) { if (age >= 18) { return ''adult''; } else { return ''minor''; } }",
      "Test it: console.log(checkAge(25)) and console.log(checkAge(14))",
      "Add else if: function rate(score) { if (score >= 90) return ''A''; else if (score >= 80) return ''B''; else return ''C''; }",
      "For your project: function isAvailable(gigs) { if (gigs.length > 0) { return ''Gigs available!''; } else { return ''No gigs today''; } }"
    ],
    "tips": [
      "=== checks both value AND type (use this, not ==)",
      "Think of conditions like yes/no questions your code asks",
      "Nesting too many if/else is called ''callback hell'' — avoid it"
    ],
    "successCriteria": "You can write an if/else function that returns different values based on input",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "JavaScript If Else Statements – Full Guide",
        "url": "https://www.youtube.com/watch?v=IsG4Xd6LlsM",
        "platform": "YouTube",
        "channel": "Web Dev Simplified",
        "duration": "15:22",
        "thumbnail": "https://img.youtube.com/vi/IsG4Xd6LlsM/maxresdefault.jpg",
        "description": "Clear walkthrough of conditionals with real examples",
        "why": "Short, focused, and packed with examples you can try immediately.",
        "timestamps": {
          "Basic if statement": "0:01:00",
          "=== vs ==": "0:04:30",
          "else if chains": "0:08:00",
          "Ternary operator shorthand": "0:12:00"
        }
      },
      "supplementary": [
        {
          "type": "article",
          "title": "javascript.info: Conditional branching",
          "url": "https://javascript.info/ifelse",
          "platform": "javascript.info",
          "description": "In-depth guide with exercises on conditionals",
          "why": "Has built-in exercises — try at least 3 after watching the video"
        }
      ]
    }
  }'::jsonb,
  true,
  3,
  44,
  NOW() - INTERVAL '3 days',
  false,
  NOW() - INTERVAL '7 days'
) ON CONFLICT (id) DO NOTHING;

-- Day 5: Arrays
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555505',
  '44444444-4444-4444-4444-444444444444',
  5,
  'Arrays: Lists of Everything',
  '{
    "description": "Arrays let you store multiple values in one variable. Essential for your gig finder app which needs to store lists of musicians and venues.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Create an array: let musicians = [''Jazz Trio'', ''Rock Band'', ''Solo Pianist''];",
      "Access items: console.log(musicians[0]) — arrays start at index 0!",
      "Get the length: console.log(musicians.length)",
      "Add an item: musicians.push(''DJ Set'');",
      "Remove last item: musicians.pop()",
      "Loop through: musicians.forEach(m => console.log(m))",
      "Filter: let bands = musicians.filter(m => m.includes(''Band''))",
      "For your project: let venues = [{name: ''Blue Note'', city: ''NYC'', capacity: 100}];"
    ],
    "tips": [
      "Arrays are zero-indexed: first item is [0], not [1]",
      "push() adds to end, pop() removes from end, shift() removes from start",
      "forEach, map, and filter are your most-used array methods"
    ],
    "successCriteria": "You can create an array, add/remove items, and loop through it",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "JavaScript Arrays and Array Methods",
        "url": "https://www.youtube.com/watch?v=7W4pQQ20nJg",
        "platform": "YouTube",
        "channel": "Traversy Media",
        "duration": "21:49",
        "thumbnail": "https://img.youtube.com/vi/7W4pQQ20nJg/maxresdefault.jpg",
        "description": "Comprehensive overview of arrays and the most useful array methods",
        "why": "Arrays are fundamental to your gig finder project. Master these methods today.",
        "timestamps": {
          "Creating arrays": "0:01:00",
          "push, pop, shift, unshift": "0:05:30",
          "forEach and map": "0:10:00",
          "filter and find": "0:15:00"
        }
      },
      "supplementary": [
        {
          "type": "interactive",
          "title": "Array Method Visualizer",
          "url": "https://javascript.info/array-methods",
          "platform": "javascript.info",
          "description": "Visual guide to all array methods with interactive examples",
          "why": "The diagrams here make array methods click instantly"
        }
      ]
    }
  }'::jsonb,
  true,
  3,
  47,
  NOW() - INTERVAL '2 days',
  false,
  NOW() - INTERVAL '7 days'
) ON CONFLICT (id) DO NOTHING;

-- Day 6: Objects
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555506',
  '44444444-4444-4444-4444-444444444444',
  6,
  'Objects: Grouping Related Data',
  '{
    "description": "Objects group related data together. Your musician gig finder needs objects to represent musicians, venues, and gigs.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Create an object: let musician = { name: ''Alex'', genre: ''Jazz'', city: ''NYC'', available: true };",
      "Access properties: console.log(musician.name)",
      "Use bracket notation: console.log(musician[''genre''])",
      "Add a property: musician.phone = ''555-1234'';",
      "Check if property exists: console.log(''phone'' in musician)",
      "Get all keys: console.log(Object.keys(musician))",
      "Nested object: let venue = { name: ''Blue Note'', location: { city: ''NYC'', state: ''NY'' } };",
      "Access nested: console.log(venue.location.city)"
    ],
    "tips": [
      "Dot notation (musician.name) is cleaner, bracket notation (musician[''name'']) is for dynamic keys",
      "Objects are like forms with labeled fields",
      "JSON (APIs use this!) is just objects in text format"

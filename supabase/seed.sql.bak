-- Day 9: Modifying the DOM
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555509',
  '44444444-4444-4444-4444-444444444444',
  9,
  'DOM Manipulation: Changing the Page',
  '{
    "description": "Now that you can read the DOM, you will learn to change it — updating text, modifying styles, and creating new elements dynamically.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Create an HTML file with: <h1 id=''title''>Hello</h1> <p id=''text''>Original text</p>",
      "Change text: document.getElementById(''title'').textContent = ''Changed!'';",
      "Change style: document.getElementById(''title'').style.color = ''blue'';",
      "Change multiple styles: let el = document.getElementById(''text''); el.style.fontSize = ''20px''; el.style.fontWeight = ''bold'';",
      "Create new element: let newP = document.createElement(''p''); newP.textContent = ''I was added by JavaScript!'';",
      "Add to page: document.body.appendChild(newP);",
      "Remove element: document.getElementById(''text'').remove();"
    ],
    "tips": [
      "innerHTML can insert HTML, textContent only inserts plain text (safer)",
      "Always select the element once and save to a variable before manipulating it",
      "CSS class manipulation (classList.add/remove/toggle) is better than inline styles"
    ],
    "successCriteria": "You can change text, style, and create/remove elements on a webpage",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "Learn DOM Manipulation In 18 Minutes",
        "url": "https://www.youtube.com/watch?v=y17RuWkWdn8",
        "platform": "YouTube",
        "channel": "Web Dev Simplified",
        "duration": "18:01",
        "thumbnail": "https://img.youtube.com/vi/y17RuWkWdn8/maxresdefault.jpg",
        "description": "Concise walkthrough of creating, modifying, and removing DOM elements",
        "why": "Perfect length for today''s content — Kyle covers exactly what you need.",
        "timestamps": {
          "Changing text content": "0:03:00",
          "Changing styles": "0:06:00",
          "Creating elements": "0:09:30",
          "Removing elements": "0:13:00"
        }
      },
      "supplementary": [
        {
          "type": "interactive",
          "title": "DOM Manipulation Exercises – javascript.info",
          "url": "https://javascript.info/modifying-document",
          "platform": "javascript.info",
          "description": "Hands-on exercises for DOM modification",
          "why": "Practice building mini DOM manipulations before your project"
        }
      ]
    }
  }'::jsonb,
  false,
  null,
  null,
  null,
  false,
  NOW() - INTERVAL '7 days'
) ON CONFLICT (id) DO NOTHING;

-- Day 10: Event Listeners
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555510',
  '44444444-4444-4444-4444-444444444444',
  10,
  'Event Listeners: Making It Interactive',
  '{
    "description": "Events make webpages respond to user actions — clicks, typing, hovering. Today you build your first truly interactive webpage.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Add a button to your HTML: <button id=''myBtn''>Click me</button>",
      "Listen for clicks: document.getElementById(''myBtn'').addEventListener(''click'', function() { alert(''Button clicked!''); });",
      "Use arrow function: document.getElementById(''myBtn'').addEventListener(''click'', () => { console.log(''Clicked!''); });",
      "Change the page on click: btn.addEventListener(''click'', () => { document.getElementById(''title'').textContent = ''You clicked!''; });",
      "Listen for typing: document.getElementById(''input'').addEventListener(''input'', (e) => { console.log(e.target.value); });",
      "Mini project: Make a button that adds a new musician name to a list when clicked"
    ],
    "tips": [
      "addEventListener(event, callback) is the modern way — never use onclick= in HTML",
      "The event object (e) contains info about what happened",
      "e.target refers to the element that triggered the event"
    ],
    "successCriteria": "You have a webpage that responds to button clicks and updates content",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "JavaScript Events – addEventListener, Event Object, Event Delegation",
        "url": "https://www.youtube.com/watch?v=XF1_MlZ5l6M",
        "platform": "YouTube",
        "channel": "Traversy Media",
        "duration": "20:00",
        "thumbnail": "https://img.youtube.com/vi/XF1_MlZ5l6M/maxresdefault.jpg",
        "description": "Complete guide to event handling in JavaScript",
        "why": "Events are the backbone of interactive apps. Brad covers everything you need for your gig finder.",
        "timestamps": {
          "addEventListener": "0:01:00",
          "The event object": "0:06:00",
          "Input events": "0:10:00",
          "Event delegation": "0:14:30"
        }
      },
      "supplementary": [
        {
          "type": "interactive",
          "title": "Build a Color Palette Generator",
          "url": "https://javascript.info/events",
          "platform": "javascript.info",
          "description": "Practice events by building a small interactive project",
          "why": "After watching the video, build the color palette — it cements event handling"
        }
      ]
    }
  }'::jsonb,
  false,
  null,
  null,
  null,
  false,
  NOW() - INTERVAL '7 days'
) ON CONFLICT (id) DO NOTHING;


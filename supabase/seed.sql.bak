-- Day 7: Loops
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555507',
  '44444444-4444-4444-4444-444444444444',
  7,
  'Loops: Repeating Actions',
  '{
    "description": "Loops let you repeat code without copying it. Today you master for loops and while loops to process lists of gigs.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "For loop: for (let i = 0; i < 5; i++) { console.log(''Step '' + i); }",
      "Loop through array: let gigs = [''Monday'', ''Wednesday'', ''Friday'']; for (let i = 0; i < gigs.length; i++) { console.log(gigs[i]); }",
      "For...of (cleaner): for (let gig of gigs) { console.log(gig); }",
      "While loop: let count = 0; while (count < 3) { console.log(count); count++; }",
      "Real project: let musicians = [{name: ''Jazz Trio'', fee: 500}, {name: ''Rock Band'', fee: 800}]; let total = 0; for (let m of musicians) { total += m.fee; } console.log(total);"
    ],
    "tips": [
      "for...of is cleaner than index-based loops for arrays",
      "Be careful with while loops — always make sure the condition eventually becomes false",
      "forEach is great when you do not need to break out of the loop early"
    ],
    "successCriteria": "You can loop through an array of objects and calculate a total",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "JavaScript Loops – for, while, for...of, forEach",
        "url": "https://www.youtube.com/watch?v=s9wW2PpJsmQ",
        "platform": "YouTube",
        "channel": "Traversy Media",
        "duration": "19:23",
        "thumbnail": "https://img.youtube.com/vi/s9wW2PpJsmQ/maxresdefault.jpg",
        "description": "All loop types explained with side-by-side comparisons",
        "why": "Brad covers all loop types in one video so you can pick the right one for each situation.",
        "timestamps": {
          "for loop": "0:01:00",
          "while loop": "0:06:00",
          "for...of loop": "0:10:00",
          "forEach method": "0:14:00"
        }
      },
      "supplementary": [
        {
          "type": "interactive",
          "title": "Loops and iteration – javascript.info",
          "url": "https://javascript.info/while-for",
          "platform": "javascript.info",
          "description": "Practice exercises for all loop types",
          "why": "The exercises at the bottom are excellent — do at least 3"
        }
      ]
    }
  }'::jsonb,
  false,
  null,
  null,
  null,
  false,
  NOW() - INTERVAL '7 days'
) ON CONFLICT (id) DO NOTHING;

-- Day 8: TODAY's task (current day — not completed yet)
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555508',
  '44444444-4444-4444-4444-444444444444',
  8,
  'DOM Basics: Reading the Webpage',
  '{
    "description": "The DOM is the bridge between JavaScript and HTML. Today you learn to select HTML elements and read their content — the foundation of making webpages interactive.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Open any webpage (try google.com) and open DevTools console",
      "Select an element: document.querySelector(''h1'')",
      "Read its text: document.querySelector(''h1'').textContent",
      "Select by class: document.querySelector(''.class-name'')",
      "Select by ID: document.getElementById(''my-id'')",
      "Select multiple: document.querySelectorAll(''p'')",
      "Loop through them: document.querySelectorAll(''p'').forEach(p => console.log(p.textContent))",
      "Count paragraphs: console.log(document.querySelectorAll(''p'').length)"
    ],
    "tips": [
      "querySelector returns the FIRST match, querySelectorAll returns ALL matches",
      "DevTools console lets you run JavaScript on any live website — great for practice",
      "CSS selectors work the same way in querySelector as in your stylesheets"
    ],
    "successCriteria": "You can select HTML elements and read their text content from the console",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "JavaScript DOM Manipulation – Full Tutorial for Beginners",
        "url": "https://www.youtube.com/watch?v=5fb2aPlgoys",
        "platform": "YouTube",
        "channel": "freeCodeCamp",
        "duration": "1:08:40",
        "thumbnail": "https://img.youtube.com/vi/5fb2aPlgoys/maxresdefault.jpg",
        "description": "The most comprehensive free DOM manipulation course for beginners",
        "why": "This is THE reference video for DOM manipulation. Bookmark it and watch 25 minutes today covering querySelector basics.",
        "timestamps": {
          "What is the DOM?": "0:01:00",
          "querySelector basics": "0:08:00",
          "querySelectorAll": "0:15:00",
          "Reading element content": "0:20:00"
        }
      },
      "supplementary": [
        {
          "type": "video",
          "title": "Learn DOM Manipulation In 18 Minutes",
          "url": "https://www.youtube.com/watch?v=y17RuWkWdn8",
          "platform": "YouTube",
          "channel": "Web Dev Simplified",
          "duration": "18:01",
          "description": "Quick comprehensive overview of DOM manipulation",
          "why": "If the freeCodeCamp video feels too long, this covers all the basics in 18 minutes"
        },
        {
          "type": "article",
          "title": "MDN: Locating DOM elements using selectors",
          "url": "https://developer.mozilla.org/en-US/docs/Web/API/Document_object_model/Locating_DOM_elements_using_selectors",

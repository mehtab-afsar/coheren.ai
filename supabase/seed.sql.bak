-- Day 1: Introduction to JavaScript
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES (
  '55555555-5555-5555-5555-555555555501',
  '44444444-4444-4444-4444-444444444444',
  1,
  'Your First Line of JavaScript',
  '{
    "description": "Open the browser console and write your first JavaScript code. You will print messages, do math, and store your first variable.",
    "type": "practice",
    "duration": 45,
    "steps": [
      "Open Chrome DevTools (Cmd+Option+J or F12)",
      "Click the Console tab",
      "Type: console.log(''Hello, World!'') and press Enter",
      "Try: console.log(2 + 2) — see the result",
      "Create your first variable: let myName = ''Alex''",
      "Print it: console.log(myName)",
      "Try: console.log(''My name is '' + myName)"
    ],
    "tips": [
      "The console is your playground — nothing you type here is permanent",
      "JavaScript is case-sensitive: myName ≠ MyName",
      "Every line of code is an instruction to the computer"
    ],
    "successCriteria": "You can create a variable and print it to the console",
    "scheduledFor": "08:00",
    "resources": {
      "primary": {
        "type": "video",
        "title": "JavaScript Crash Course For Beginners",
        "url": "https://www.youtube.com/watch?v=hdI2bqOjy3c",

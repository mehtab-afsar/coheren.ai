-- Admin user tasks (same content as seed user, linked to DDDD roadmap)
INSERT INTO public.daily_tasks (id, roadmap_id, day_number, title, content, is_completed, difficulty_rating, actual_duration, completed_at, skipped, created_at)
VALUES
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE01','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',1,'Your First Line of JavaScript','{"description":"Open the browser console and write your first JavaScript code. You will print messages, do math, and store your first variable.","type":"practice","duration":45,"steps":["Open Chrome DevTools (Cmd+Option+J or F12)","Click the Console tab","Type: console.log(''Hello, World!'') and press Enter","Try: console.log(2 + 2) — see the result","Create your first variable: let myName = ''Alex''","Print it: console.log(myName)","Try: console.log(''My name is '' + myName)"],"tips":["The console is your playground — nothing you type here is permanent","JavaScript is case-sensitive: myName ≠ MyName","Every line of code is an instruction to the computer"],"successCriteria":"You can create a variable and print it to the console","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Crash Course For Beginners","url":"https://www.youtube.com/watch?v=hdI2bqOjy3c","platform":"YouTube","channel":"Traversy Media","duration":"1:40:30","thumbnail":"https://img.youtube.com/vi/hdI2bqOjy3c/maxresdefault.jpg","description":"Complete beginner-friendly JavaScript overview covering all fundamentals","why":"Brad Traversy is known for clear, no-fluff explanations. Watch the first 20 minutes for today''s content.","timestamps":{"Variables & Data Types":"0:05:00","console.log":"0:08:30","let vs const vs var":"0:12:00"}},"supplementary":[{"type":"interactive","title":"JavaScript.info — Variables","url":"https://javascript.info/variables","platform":"javascript.info","description":"The best written JavaScript reference, free online","why":"Great reference to read after watching the video"}]}}'::jsonb,true,2,42,NOW() - INTERVAL '6 days',false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE02','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',2,'Data Types: Strings, Numbers, and Booleans','{"description":"Every piece of data has a type. Today you learn the 3 most common types and how JavaScript handles them.","type":"practice","duration":45,"steps":["Open the console and try: typeof ''hello''","Try: typeof 42 and typeof true","Create a string: let greeting = ''Good morning!''","Get its length: console.log(greeting.length)","Convert a number to string: String(42)","Convert a string to number: Number(''3.14'')","Explore: what happens with typeof null?"],"tips":["Strings are always wrapped in quotes (single or double)","NaN means Not a Number","typeof is a handy debugging tool"],"successCriteria":"You can identify and convert between string, number, and boolean types","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Data Types Explained","url":"https://www.youtube.com/watch?v=O9by2KcR2v4","platform":"YouTube","channel":"Fireship","duration":"11:44","thumbnail":"https://img.youtube.com/vi/O9by2KcR2v4/maxresdefault.jpg","description":"Fast-paced, visually engaging explanation of JS data types","why":"Fireship makes complex concepts click in under 15 minutes.","timestamps":{"Primitive types overview":"0:00:30","String methods":"0:03:00","Type coercion":"0:07:30"}},"supplementary":[{"type":"article","title":"MDN: JavaScript data types","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Data_structures","platform":"MDN Web Docs","description":"Official Mozilla reference for JavaScript types","why":"Bookmark MDN — it will be your reference for years"}]}}'::jsonb,true,2,48,NOW() - INTERVAL '5 days',false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE03','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',3,'Writing Your First Functions','{"description":"Functions are reusable blocks of code. Today you learn to write functions that take inputs and return outputs.","type":"practice","duration":45,"steps":["Write a function: function greet(name) { return ''Hello, '' + name + ''!''; }","Call it: console.log(greet(''Alex''))","Write a math function: function add(a, b) { return a + b; }","Try arrow function syntax: const multiply = (a, b) => a * b;","Call: console.log(multiply(4, 6))"],"tips":["A function without a return statement returns undefined","Arrow functions (=>) are modern shorthand","Functions should do ONE thing"],"successCriteria":"You can write a function with parameters that returns a value","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Functions – Explain Like I''m Five","url":"https://www.youtube.com/watch?v=N8ap4k_1QEQ","platform":"YouTube","channel":"Web Dev Simplified","duration":"20:14","thumbnail":"https://img.youtube.com/vi/N8ap4k_1QEQ/maxresdefault.jpg","description":"Kyle Cook''s approachable style makes functions easy to understand","why":"Best beginner explanation of functions.","timestamps":{"Function declaration":"0:00:45","Parameters and arguments":"0:04:00","Return values":"0:08:30","Arrow functions":"0:14:00"}},"supplementary":[{"type":"interactive","title":"Codecademy: Functions in JavaScript","url":"https://www.codecademy.com/learn/introduction-to-javascript/modules/learn-javascript-functions","platform":"Codecademy","description":"Hands-on exercises for writing functions","why":"Practice makes permanent"}]}}'::jsonb,true,3,50,NOW() - INTERVAL '4 days',false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE04','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',4,'Making Decisions with If/Else','{"description":"Programs make decisions based on conditions. Learn if/else to make your code respond differently to different inputs.","type":"practice","duration":45,"steps":["Write: if (5 > 3) { console.log(''Math works!''); }","Add an else: if (5 < 3) { console.log(''No''); } else { console.log(''Yes!''); }","Create a function: function checkAge(age) { if (age >= 18) { return ''adult''; } else { return ''minor''; } }","Test it: console.log(checkAge(25)) and console.log(checkAge(14))"],"tips":["=== checks both value AND type (use this, not ==)","Think of conditions like yes/no questions","Nesting too many if/else is called callback hell"],"successCriteria":"You can write an if/else function that returns different values based on input","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript If Else Statements – Full Guide","url":"https://www.youtube.com/watch?v=IsG4Xd6LlsM","platform":"YouTube","channel":"Web Dev Simplified","duration":"15:22","thumbnail":"https://img.youtube.com/vi/IsG4Xd6LlsM/maxresdefault.jpg","description":"Clear walkthrough of conditionals with real examples","why":"Short, focused, and packed with examples.","timestamps":{"Basic if statement":"0:01:00","=== vs ==":"0:04:30","else if chains":"0:08:00","Ternary operator":"0:12:00"}},"supplementary":[{"type":"article","title":"javascript.info: Conditional branching","url":"https://javascript.info/ifelse","platform":"javascript.info","description":"In-depth guide with exercises","why":"Has built-in exercises — try at least 3"}]}}'::jsonb,true,3,44,NOW() - INTERVAL '3 days',false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE05','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',5,'Arrays: Lists of Everything','{"description":"Arrays let you store multiple values in one variable. Essential for Coheren which needs to store lists of goals and tasks.","type":"practice","duration":45,"steps":["Create an array: let goals = [''Learn JS'', ''Build App'', ''Ship Product''];","Access items: console.log(goals[0])","Get the length: console.log(goals.length)","Add an item: goals.push(''Get Users'');","Loop through: goals.forEach(g => console.log(g))","Filter: let longGoals = goals.filter(g => g.length > 8)"],"tips":["Arrays are zero-indexed: first item is [0], not [1]","push() adds to end, pop() removes from end","forEach, map, and filter are your most-used array methods"],"successCriteria":"You can create an array, add/remove items, and loop through it","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Arrays and Array Methods","url":"https://www.youtube.com/watch?v=7W4pQQ20nJg","platform":"YouTube","channel":"Traversy Media","duration":"21:49","thumbnail":"https://img.youtube.com/vi/7W4pQQ20nJg/maxresdefault.jpg","description":"Comprehensive overview of arrays and the most useful array methods","why":"Arrays are fundamental to Coheren. Master these methods today.","timestamps":{"Creating arrays":"0:01:00","push, pop, shift, unshift":"0:05:30","forEach and map":"0:10:00","filter and find":"0:15:00"}},"supplementary":[{"type":"interactive","title":"Array Method Visualizer","url":"https://javascript.info/array-methods","platform":"javascript.info","description":"Visual guide to all array methods","why":"The diagrams here make array methods click instantly"}]}}'::jsonb,true,3,47,NOW() - INTERVAL '2 days',false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE06','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',6,'Objects: Grouping Related Data','{"description":"Objects group related data together. Coheren uses objects everywhere to represent goals, tasks, and users.","type":"practice","duration":45,"steps":["Create an object: let goal = { title: ''Learn JS'', category: ''tech'', days: 84, active: true };","Access properties: console.log(goal.title)","Add a property: goal.streak = 7;","Get all keys: console.log(Object.keys(goal))","Nested object: let user = { name: ''Mehtab'', goal: { title: ''Learn JS'', day: 8 } };","Access nested: console.log(user.goal.day)"],"tips":["Dot notation (goal.title) is cleaner, bracket notation for dynamic keys","Objects are like forms with labeled fields","JSON is just objects in text format"],"successCriteria":"You can create an object, read/write properties, and nest objects","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Objects Explained","url":"https://www.youtube.com/watch?v=PFmuCDHHpwk","platform":"YouTube","channel":"Web Dev Simplified","duration":"21:35","thumbnail":"https://img.youtube.com/vi/PFmuCDHHpwk/maxresdefault.jpg","description":"Complete guide to JavaScript objects with practical examples","why":"Kyle''s object tutorial is the clearest one available for beginners.","timestamps":{"Object literals":"0:01:00","Dot vs bracket notation":"0:05:00","Methods on objects":"0:10:00","Destructuring":"0:16:00"}},"supplementary":[{"type":"article","title":"MDN: Working with Objects","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Working_with_objects","platform":"MDN Web Docs","description":"Official guide with all object methods","why":"Reference this whenever you need an object method"}]}}'::jsonb,true,4,52,NOW() - INTERVAL '1 day',false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE07','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',7,'Loops: Repeating Actions','{"description":"Loops let you repeat code without copying it. Today you master for loops and while loops.","type":"practice","duration":45,"steps":["For loop: for (let i = 0; i < 5; i++) { console.log(''Step '' + i); }","For...of (cleaner): for (let goal of goals) { console.log(goal); }","While loop: let count = 0; while (count < 3) { console.log(count); count++; }"],"tips":["for...of is cleaner than index-based loops","Be careful with while loops — always ensure condition becomes false","forEach is great when you don''t need to break early"],"successCriteria":"You can loop through an array of objects and calculate a total","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Loops – for, while, for...of, forEach","url":"https://www.youtube.com/watch?v=s9wW2PpJsmQ","platform":"YouTube","channel":"Traversy Media","duration":"19:23","thumbnail":"https://img.youtube.com/vi/s9wW2PpJsmQ/maxresdefault.jpg","description":"All loop types explained with side-by-side comparisons","why":"Brad covers all loop types in one video.","timestamps":{"for loop":"0:01:00","while loop":"0:06:00","for...of loop":"0:10:00","forEach method":"0:14:00"}},"supplementary":[{"type":"interactive","title":"Loops and iteration – javascript.info","url":"https://javascript.info/while-for","platform":"javascript.info","description":"Practice exercises for all loop types","why":"The exercises are excellent — do at least 3"}]}}'::jsonb,false,null,null,null,false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE08','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',8,'DOM Basics: Reading the Webpage','{"description":"The DOM is the bridge between JavaScript and HTML. Today you learn to select HTML elements and read their content.","type":"practice","duration":45,"steps":["Open any webpage and open DevTools console","Select an element: document.querySelector(''h1'')","Read its text: document.querySelector(''h1'').textContent","Select by class: document.querySelector(''.class-name'')","Select by ID: document.getElementById(''my-id'')","Select multiple: document.querySelectorAll(''p'')","Loop through them: document.querySelectorAll(''p'').forEach(p => console.log(p.textContent))"],"tips":["querySelector returns the FIRST match, querySelectorAll returns ALL matches","DevTools console lets you run JavaScript on any live website","CSS selectors work the same in querySelector as in stylesheets"],"successCriteria":"You can select HTML elements and read their text content from the console","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript DOM Manipulation – Full Tutorial for Beginners","url":"https://www.youtube.com/watch?v=5fb2aPlgoys","platform":"YouTube","channel":"freeCodeCamp","duration":"1:08:40","thumbnail":"https://img.youtube.com/vi/5fb2aPlgoys/maxresdefault.jpg","description":"The most comprehensive free DOM manipulation course for beginners","why":"This is THE reference video for DOM manipulation. Watch 25 minutes today covering querySelector basics.","timestamps":{"What is the DOM?":"0:01:00","querySelector basics":"0:08:00","querySelectorAll":"0:15:00","Reading element content":"0:20:00"}},"supplementary":[{"type":"video","title":"Learn DOM Manipulation In 18 Minutes","url":"https://www.youtube.com/watch?v=y17RuWkWdn8","platform":"YouTube","channel":"Web Dev Simplified","duration":"18:01","description":"Quick overview of DOM manipulation","why":"If the freeCodeCamp video feels too long, this covers the basics in 18 minutes"},{"type":"article","title":"MDN: Locating DOM elements using selectors","url":"https://developer.mozilla.org/en-US/docs/Web/API/Document_object_model/Locating_DOM_elements_using_selectors","platform":"MDN Web Docs","description":"Reference guide for all querySelector methods","why":"Save for when you need a specific selector syntax"}]}}'::jsonb,false,null,null,null,false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE09','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',9,'DOM Manipulation: Changing the Page','{"description":"Now that you can read the DOM, you will learn to change it — updating text, modifying styles, and creating new elements dynamically.","type":"practice","duration":45,"steps":["Create an HTML file with: <h1 id=''title''>Hello</h1>","Change text: document.getElementById(''title'').textContent = ''Changed!'';","Change style: document.getElementById(''title'').style.color = ''blue'';","Create new element: let newP = document.createElement(''p''); newP.textContent = ''Added!'';","Add to page: document.body.appendChild(newP);"],"tips":["innerHTML can insert HTML, textContent only inserts plain text (safer)","CSS class manipulation (classList.add/remove/toggle) is better than inline styles"],"successCriteria":"You can change text, style, and create/remove elements on a webpage","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"Learn DOM Manipulation In 18 Minutes","url":"https://www.youtube.com/watch?v=y17RuWkWdn8","platform":"YouTube","channel":"Web Dev Simplified","duration":"18:01","thumbnail":"https://img.youtube.com/vi/y17RuWkWdn8/maxresdefault.jpg","description":"Concise walkthrough of creating, modifying, and removing DOM elements","why":"Perfect length for today''s content.","timestamps":{"Changing text content":"0:03:00","Changing styles":"0:06:00","Creating elements":"0:09:30","Removing elements":"0:13:00"}},"supplementary":[{"type":"interactive","title":"DOM Manipulation Exercises – javascript.info","url":"https://javascript.info/modifying-document","platform":"javascript.info","description":"Hands-on exercises for DOM modification","why":"Practice building mini DOM manipulations before your project"}]}}'::jsonb,false,null,null,null,false,NOW() - INTERVAL '7 days'),
  ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEE10','DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD',10,'Event Listeners: Making It Interactive','{"description":"Events make webpages respond to user actions — clicks, typing, hovering. Today you build your first truly interactive webpage.","type":"practice","duration":45,"steps":["Add a button: <button id=''myBtn''>Click me</button>","Listen for clicks: document.getElementById(''myBtn'').addEventListener(''click'', () => { console.log(''Clicked!''); });","Change page on click: btn.addEventListener(''click'', () => { document.getElementById(''title'').textContent = ''You clicked!''; });","Listen for typing: input.addEventListener(''input'', (e) => { console.log(e.target.value); });"],"tips":["addEventListener(event, callback) is the modern way","The event object (e) contains info about what happened","e.target refers to the element that triggered the event"],"successCriteria":"You have a webpage that responds to button clicks and updates content","scheduledFor":"08:00","resources":{"primary":{"type":"video","title":"JavaScript Events – addEventListener, Event Object, Event Delegation","url":"https://www.youtube.com/watch?v=XF1_MlZ5l6M","platform":"YouTube","channel":"Traversy Media","duration":"20:00","thumbnail":"https://img.youtube.com/vi/XF1_MlZ5l6M/maxresdefault.jpg","description":"Complete guide to event handling in JavaScript","why":"Events are the backbone of interactive apps.","timestamps":{"addEventListener":"0:01:00","The event object":"0:06:00","Input events":"0:10:00","Event delegation":"0:14:30"}},"supplementary":[{"type":"interactive","title":"Build a Color Palette Generator","url":"https://javascript.info/events","platform":"javascript.info","description":"Practice events by building a small interactive project","why":"Cements event handling in a fun way"}]}}'::jsonb,false,null,null,null,false,NOW() - INTERVAL '7 days')
ON CONFLICT (id) DO NOTHING;

